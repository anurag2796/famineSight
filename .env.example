# ─── ACLED Credentials ────────────────────────────────────────────────────────
# Register at https://acleddata.com/ to get credentials
ACLED_EMAIL=your_email_here
ACLED_PASSWORD=your_password_here

# ─── LLM Configuration ────────────────────────────────────────────────────────
# Ollama: runs on host; accessible inside Docker via host.docker.internal
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:32b

# Groq (optional cloud fallback — leave empty to use Ollama only)
GROQ_API_KEY=
GROQ_MODEL=llama3-8b-8192

# ─── Service URLs ─────────────────────────────────────────────────────────────
BACKEND_URL=http://backend:8000

# CORS: comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://frontend:8501

# ─── API Security ─────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=replace_with_a_strong_random_key

# ─── Jetson AGX Orin Hardware Tuning ─────────────────────────────────────────
RF_N_JOBS=4
XGB_DEVICE=cpu